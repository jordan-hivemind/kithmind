{
  "name": "@repo/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "pnpm --filter @repo/worker-protocol check-types && tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:once": "node --test --test-concurrency=1 test/*.test.mjs",
    "pipeline": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "25.3.3",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@repo/worker-protocol": "workspace:*"
  }
}
