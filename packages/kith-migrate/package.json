{
  "name": "@repo/kith-migrate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "kith-migrate": "./dist/cli.js"
  },
  "scripts": {
    "build": "node ../../scripts/run-package-task.mjs build tsc -p tsconfig.json",
    "check-types": "node ../../scripts/run-package-task.mjs check-types tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-package-task.mjs test node --test test/*.test.mjs",
    "test:once": "node ../../scripts/run-package-task.mjs test node --test test/*.test.mjs",
    "test:integration": "node ../../scripts/run-package-task.mjs test node --test integration/*.test.mjs",
    "generate:migration": "pnpm run build && node dist/cli.js ddl:generate --out ../kith-store/migrations/004_kith_migrate_tables.sql"
  },
  "dependencies": {
    "@repo/kith-store": "workspace:*",
    "@repo/pg": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "25.3.3",
    "@types/pg": "^8.15.5",
    "typescript": "^5.7.0"
  }
}
