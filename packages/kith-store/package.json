{
  "name": "@repo/kith-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./identity": {
      "types": "./src/identity/index.ts",
      "node": "./dist/identity/index.js",
      "default": "./src/identity/index.ts"
    },
    "./ingestion": {
      "types": "./src/ingestion/index.ts",
      "node": "./dist/ingestion/index.js",
      "default": "./src/ingestion/index.ts"
    },
    "./workers": {
      "types": "./src/workers/index.ts",
      "node": "./dist/workers/index.js",
      "default": "./src/workers/index.ts"
    }
  },
  "scripts": {
    "build": "node ../../scripts/run-package-task.mjs build tsc -p tsconfig.json",
    "check-types": "node ../../scripts/run-package-task.mjs check-types tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-package-task.mjs test node --test test/*.test.mjs",
    "test:once": "node ../../scripts/run-package-task.mjs test node --test test/*.test.mjs",
    "test:integration": "node ../../scripts/run-package-task.mjs test node --test integration/*.test.mjs"
  },
  "dependencies": {
    "@repo/finance-contract": "workspace:*",
    "@repo/pg": "workspace:*",
    "@repo/worker-protocol": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@repo/finance-archive": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "25.3.3",
    "@types/pg": "^8.15.5",
    "typescript": "^5.7.0"
  }
}
