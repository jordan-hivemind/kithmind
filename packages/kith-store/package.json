{
  "name": "@repo/kith-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./identity": {
      "types": "./src/identity/index.ts",
      "node": "./dist/identity/index.js",
      "default": "./src/identity/index.ts"
    },
    "./ingestion": {
      "types": "./src/ingestion/index.ts",
      "node": "./dist/ingestion/index.js",
      "default": "./src/ingestion/index.ts"
    },
    "./workers": {
      "types": "./src/workers/index.ts",
      "node": "./dist/workers/index.js",
      "default": "./src/workers/index.ts"
    },
    "./records": {
      "types": "./src/records/index.ts",
      "node": "./dist/records/index.js",
      "default": "./src/records/index.ts"
    },
    "./embeddings": {
      "types": "./src/embeddings/index.ts",
      "node": "./dist/embeddings/index.js",
      "default": "./src/embeddings/index.ts"
    },
    "./coverage": {
      "types": "./src/coverage/index.ts",
      "node": "./dist/coverage/index.js",
      "default": "./src/coverage/index.ts"
    },
    "./eval": {
      "types": "./src/eval/index.ts",
      "node": "./dist/eval/index.js",
      "default": "./src/eval/index.ts"
    },
    "./sources": {
      "types": "./src/sources/index.ts",
      "node": "./dist/sources/index.js",
      "default": "./src/sources/index.ts"
    },
    "./admin": {
      "types": "./src/admin/index.ts",
      "node": "./dist/admin/index.js",
      "default": "./src/admin/index.ts"
    },
    "./extraction": {
      "types": "./src/extraction/index.ts",
      "node": "./dist/extraction/index.js",
      "default": "./src/extraction/index.ts"
    },
    "./deferred": {
      "types": "./src/deferred/index.ts",
      "node": "./dist/deferred/index.js",
      "default": "./src/deferred/index.ts"
    }
  },
  "bin": {
    "kith-deferred-work": "./dist/deferred/cli.js",
    "kith-discovery-reset": "./dist/workers/cli.js",
    "kith-extraction-backfill": "./dist/extraction/cli.js",
    "kith-extraction-diagnose": "./dist/extraction/diagnoseCli.js",
    "kith-extraction-span-cleanup": "./dist/extraction/spanCleanupCli.js",
    "kith-reembed": "./dist/embeddings/cli.js"
  },
  "scripts": {
    "build": "node ../../scripts/run-package-task.mjs build tsc -p tsconfig.json",
    "check-types": "node ../../scripts/run-package-task.mjs check-types tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-package-task.mjs test node --test test/*.test.mjs",
    "test:once": "node ../../scripts/run-package-task.mjs test node --test test/*.test.mjs",
    "test:integration": "node ../../scripts/run-package-task.mjs test node --test integration/*.test.mjs"
  },
  "dependencies": {
    "@repo/finance-contract": "workspace:*",
    "@repo/pg": "workspace:*",
    "@repo/worker-protocol": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@repo/finance-archive": "workspace:*",
    "@repo/pipeline": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "25.3.3",
    "@types/pg": "^8.15.5",
    "typescript": "^5.7.0"
  }
}
