{
  "name": "@repo/plaid-feed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "kith-plaid-feed": "./dist/cli.js"
  },
  "scripts": {
    "build": "node ../../scripts/run-package-task.mjs build tsc -p tsconfig.json",
    "check-types": "node ../../scripts/run-package-task.mjs check-types tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-package-task.mjs test node --test test/*.test.mjs",
    "test:once": "node ../../scripts/run-package-task.mjs test node --test test/*.test.mjs"
  },
  "dependencies": {
    "@repo/kith-store": "workspace:*",
    "@repo/pg": "workspace:*",
    "pg": "^8.16.3",
    "plaid": "^47.0.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "25.3.3",
    "@types/pg": "^8.15.5",
    "typescript": "^5.7.0"
  }
}
