{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["scripts/run-package-task.mjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "cache": false,
      "dependsOn": ["build"],
      "persistent": true
    },
    "test:once": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "@repo/worker-protocol#test:once": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "@repo/pipeline#test:once": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "@repo/finance-archive#test:once": {
      "cache": false,
      "dependsOn": ["build"],
      "passThroughEnv": [
        "FINANCE_ARCHIVE_DATABASE_URL",
        "FINANCE_ARCHIVE_REQUIRE_DATABASE",
        "FINANCE_ARCHIVE_SCHEMA",
        "FINANCE_ARCHIVE_SPACE_ID"
      ]
    },
    "@repo/pg#test:once": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "@repo/kith-store#test:once": {
      "cache": false,
      "dependsOn": ["build"],
      "passThroughEnv": [
        "KITH_STORE_DATABASE_URL",
        "KITH_STORE_REQUIRE_DATABASE"
      ]
    },
    "@repo/kith-migrate#test:once": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "@repo/plaid-feed#test:once": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "@repo/finance-contract#test:once": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "@repo/web#test:once": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": ["KITH_STORE_DATABASE_URL"]
    },
    "@repo/ingest-simple#test:once": {
      "cache": false,
      "dependsOn": ["build"],
      "passThroughEnv": ["KITH_STORE_DATABASE_URL"]
    }
  },
  "globalPassThroughEnv": ["PORT", "WEB_PORT"],
  "globalEnv": [
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "MCP_PUBLIC_ORIGIN",
    "MCP_OAUTH_ENCRYPTION_KEY",
    "MCP_TOOL_PROFILE",
    "FINANCE_ARCHIVE_READER_DATABASE_URL",
    "FINANCE_ARCHIVE_SPACE_ID",
    "KITH_DATABASE_URL",
    "KITH_SESSION_SECRET",
    "KITH_DOCUMENT_DROPBOX"
  ]
}
