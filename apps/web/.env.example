# Stable public origin of this Next.js deployment, without a trailing slash.
MCP_PUBLIC_ORIGIN=

# OAuth encryption key: 32 random bytes, base64url. Treat it as a secret. Do
# not commit filled-in values.
MCP_OAUTH_ENCRYPTION_KEY=

# The `kith` schema's pooled writer endpoint, server-side only.
KITH_DATABASE_URL=
# Session cookie HMAC key, at least 32 characters.
KITH_SESSION_SECRET=

# Optional Google web sign-in. Configure all three together. The origin is the
# production HTTPS origin without a path or trailing slash. Development derives
# an explicitly registered localhost callback from the current dev-server port.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ORIGIN=
# Optional organization-only auto-link. Configure both to permit the one
# already-established Kith user to link on first Google sign-in.
GOOGLE_OAUTH_HOSTED_DOMAIN=
GOOGLE_OAUTH_AUTOLINK_USER_ID=

# Runtime tool profile. `full` is the default; `memory` is a narrower
# memory-only surface.
MCP_TOOL_PROFILE=full

# Optional finance provider. Configure all three together, server-side only.
FINANCE_ARCHIVE_READER_DATABASE_URL=
FINANCE_ARCHIVE_SPACE_ID=
# Stable random secret of at least 32 bytes. Rotation invalidates open cursors.
FINANCE_ARCHIVE_CURSOR_SECRET=
# Optional finance review writes. Use the archive writer endpoint, never the
# reader role. The same pinned FINANCE_ARCHIVE_SPACE_ID governs these actions.
FINANCE_ARCHIVE_DATABASE_URL=

# Optional authenticated original-document viewing. The value is one-line
# JSON stored only as a server-side secret. `expectedAccountIdHash` is the
# lowercase SHA-256 of the Dropbox account id. Each root binds one Kith source
# account and its stored `fs://<alias>/...` URI to a Dropbox folder. This
# synthetic shape contains no usable credential:
# KITH_DOCUMENT_DROPBOX={"clientId":"synthetic-app-id","clientSecret":"synthetic-app-secret","refreshToken":"synthetic-refresh-token","expectedAccountIdHash":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","roots":[{"sourceAccountId":"synthetic-source-account","alias":"inbox","path":"/Synthetic Inbox"}]}
