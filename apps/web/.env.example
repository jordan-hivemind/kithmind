# Public browser configuration. This is the only value here that may use the
# NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CONVEX_URL=

# Stable public origin of this Next.js deployment, without a trailing slash.
MCP_JWT_ISSUER=

# `MCP_JWT_KEY_ID` is optional and defaults to `mcp-1`. Generate the JWK pair
# and OAuth encryption key with `pnpm generate:mcp-jwks`. Treat private values
# as secrets. Do not commit filled-in values.
MCP_JWT_KEY_ID=
MCP_JWT_PRIVATE_JWK=
MCP_JWT_PUBLIC_JWK=
MCP_OAUTH_ENCRYPTION_KEY=

# Runtime tool profile. `full` is the default; `memory` is a narrower
# memory-only surface. This is independent of the core/full preflight profiles.
# The gateway still needs its auth/JWKS settings.
MCP_TOOL_PROFILE=full
