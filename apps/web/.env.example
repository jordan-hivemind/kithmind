# Stable public origin of this Next.js deployment, without a trailing slash.
MCP_PUBLIC_ORIGIN=

# OAuth encryption key: 32 random bytes, base64url. Treat it as a secret. Do
# not commit filled-in values.
MCP_OAUTH_ENCRYPTION_KEY=

# The `kith` schema's pooled writer endpoint, server-side only.
KITH_DATABASE_URL=
# Session cookie HMAC key, at least 32 characters.
KITH_SESSION_SECRET=

# Runtime tool profile. `full` is the default; `memory` is a narrower
# memory-only surface.
MCP_TOOL_PROFILE=full

# Optional finance provider. Configure all three together, server-side only.
FINANCE_ARCHIVE_READER_DATABASE_URL=
FINANCE_ARCHIVE_SPACE_ID=
# Stable random secret of at least 32 bytes. Rotation invalidates open cursors.
FINANCE_ARCHIVE_CURSOR_SECRET=
