{
  "name": "kithmind",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:once": "turbo run test:once && node --test scripts/*.test.mjs",
    "eval:recall:postgres": "pnpm --filter @repo/kith-store build && pnpm --filter @repo/kith-store exec node eval/run-recall-parity.mjs",
    "check:self-hosting": "node scripts/check-self-hosting.mjs --web",
    "test:self-hosting": "node --test scripts/check-self-hosting.test.mjs",
    "demo:brain": "node scripts/demo-brain.mjs",
    "brain:worker": "pnpm --filter @repo/pipeline pipeline",
    "brain:doctor": "node scripts/check-self-hosting.mjs --worker",
    "parser:setup": "node scripts/parser-runtime-setup.mjs",
    "receipts:normalize": "node scripts/receipt-images-to-pdf.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "sharp": "^0.35.4",
      "js-yaml@^4.0.0": "^4.3.2",
      "hono": "^4.13.5"
    }
  }
}
